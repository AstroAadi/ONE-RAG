# ====================================================================
# RAG SYSTEM CONFIGURATION - OPEN SOURCE MODELS
# ====================================================================

# ==================== HuggingFace Configuration ====================
# Get your free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=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

# ==================== LLM Model Configuration ====================
# Current LLM model (can be changed via API)
LLM_MODEL_ID=meta-llama/Meta-Llama-3-8B-Instruct

# Available options:
# - meta-llama/Meta-Llama-3-8B-Instruct
# - mistralai/Mistral-7B-Instruct-v0.2
# - google/gemma-7b-it

# ==================== Embedding Model Configuration ====================
# Current embedding model
EMBEDDING_MODEL_ID=BAAI/bge-large-en-v1.5

# Available options:
# - BAAI/bge-large-en-v1.5 (1024 dims, best quality)
# - sentence-transformers/all-MiniLM-L6-v2 (384 dims, fastest)
# - intfloat/e5-large-v2 (1024 dims, good balance)

# Max characters for embedding (model dependent)
EMBEDDING_MAX_LENGTH=512

# ==================== Vision Model Configuration ====================
# Current vision model
VISION_MODEL_ID=llava-hf/llava-1.5-7b-hf

# Available options:
# - llava-hf/llava-1.5-7b-hf (best for general images)
# - microsoft/Phi-3-vision-128k-instruct (good for documents)
# - SkunkworksAI/BakLLaVA-1 (alternative)

# ==================== Model Parameters ====================
# LLM temperature (0.0 = deterministic, 1.0 = creative) 
TEMPERATURE=0.6

# Max tokens for LLM response
MAX_TOKENS=2048

# Vision model parameters
VISION_MAX_TOKENS=1024
VISION_TEMPERATURE=0.3

# ==================== Qdrant Vector Database ====================
# Qdrant Cloud URL (e.g., https://xxxxx.cloud.qdrant.io)
QDRANT_URL=https://7757a37f-aacc-40f5-aa9a-3e80c98078f8.europe-west3-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIn0.1hMZGVX4sq_T9K_1dtA2tptHdJMh4cCDskxR9radzbU
QDRANT_COLLECTION_NAME=rag_documents

# ==================== Storage Configuration ====================
UPLOAD_DIR=./uploads
MARKDOWN_DIR=./markdown_output
DATABASE_URL=sqlite:///./rag_system.db

# File upload limits
MAX_FILE_SIZE_MB=50
MAX_FILENAME_LENGTH=255

# ==================== Chunking Configuration ====================
# Token-based chunking (recommended)
MIN_CHUNK_TOKENS=200
TARGET_CHUNK_TOKENS=512
MAX_CHUNK_TOKENS=600
CHUNK_OVERLAP_TOKENS=50

# Tokenizer to use
TOKENIZER_MODEL=cl100k_base

# ==================== RAG Configuration ====================
DEFAULT_TOP_K=5
MAX_TOP_K=20
MAX_CONTEXT_LENGTH=4096

# ==================== Conversation Configuration ====================
MAX_CONVERSATION_TURNS=5
CONVERSATION_CLEANUP_MINUTES=60

# ==================== Document Processing ====================
ENABLE_AI_IMAGE_ANALYSIS=true
EXTRACT_IMAGES=true
INFER_TABLE_STRUCTURE=true
ENABLE_OCR=true

IMAGE_SCALE=2.0
IMAGE_QUALITY=85

# ==================== Logging Configuration ====================
LOG_LEVEL=INFO
ENABLE_QUERY_LOGGING=true
ENABLE_PERFORMANCE_METRICS=true
LOG_FILE_PATH=./logs/rag_system.log

# ==================== Error Handling ====================
MAX_RETRIES=3
RETRY_DELAY_SECONDS=1.0

# ==================== Feature Flags ====================
ENABLE_CONVERSATION_HISTORY=true
ENABLE_HALLUCINATION_DETECTION=false
HALLUCINATION_THRESHOLD=0.6

# ==================== Security ====================
MAX_USER_ID_LENGTH=100